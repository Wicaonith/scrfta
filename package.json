{
  "name": "scrfta",
  "version": "1.0.0",
  "description": "Scrapper des compétitions FFTA (ffta.fr/competitions) avec récupération et analyse des mandats",
  "main": "src/scrape.js",
  "type": "module",
  "scripts": {
    "scrape": "node src/scrape.js",
    "reparse": "node src/reparse.js",
    "postinstall": "node scripts/install-hooks.mjs && playwright install chromium",
    "rapport": "node src/rapport.js",
    "voir": "node src/ouvrir.js",
    "test": "node --test \"test/*.test.js\"",
    "snapshot": "node scripts/update-snapshot.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-functions=90 \"test/*.test.js\"",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-functions=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml \"test/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "pdf-to-img": "^7.0.0",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.50.0",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/wicaonith/scrfta.git"
  }
}
